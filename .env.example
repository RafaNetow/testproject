# Supabase — Project Settings > API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-only, never expose to the browser. Used only by
# src/lib/supabase/admin.ts (Documenso webhook, invite-before-signup).
SUPABASE_SERVICE_ROLE_KEY=

# Base URL used in invite emails' sign-in link. Defaults to https://www.alchemica.dk;
# `npm run db:env` sets it to http://localhost:3000 for local development.
NEXT_PUBLIC_SITE_URL=

# Resend — resend.com/api-keys
RESEND_API_KEY=
# Inbox the contact form delivers to — defaults to hello@alchemica.com if unset
CONTACT_TO_EMAIL=

# Shared secret for /api/cron/weekly-digest. Vercel Cron sends it as
# `Authorization: Bearer <secret>` (set the same value in the Vercel project).
CRON_SECRET=

# Documenso — hosted (documenso.com) API key, added in Phase 6
DOCUMENSO_API_KEY=
# Set when configuring the webhook in Documenso (Settings > Webhooks),
# pointing it at /api/webhooks/documenso. Verifies incoming webhook requests.
DOCUMENSO_WEBHOOK_SECRET=
